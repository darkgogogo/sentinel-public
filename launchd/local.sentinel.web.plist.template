<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.sentinel.web</string>

    <key>ProgramArguments</key>
    <array>
        <string>{PYTHON_PATH}</string>
        <string>-m</string>
        <string>sentinel</string>
        <string>web</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{SENTINEL_HOME}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>{SENTINEL_HOME}</string>
        <key>PATH</key>
        <string>{HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>{HOME}</string>
    </dict>

    <!-- Web UI 跟其他 service 不一样：长驻而非定时触发 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 进程挂了自动重启（KeepAlive=true 比 SuccessfulExit 友好，重启策略 launchd 全权） -->
    <key>KeepAlive</key>
    <true/>

    <!-- 重启间隔 ≥10s 避免 crash loop 烧 CPU -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>{SENTINEL_HOME}/logs/web.log</string>

    <key>StandardErrorPath</key>
    <string>{SENTINEL_HOME}/logs/web.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
