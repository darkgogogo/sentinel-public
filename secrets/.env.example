# Sentinel v2 密钥（拷贝为 .env 后填）· chmod 600 · 永不进 git

# Telegram（telethon · collector + push 双用）
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=                  # push 用
TELEGRAM_CHAT_ID=                    # push 目标 chat

# Anthropic（仅 llm.provider=api 模式用 · 默认 cli 模式跳过）
ANTHROPIC_API_KEY=

